# Origin produksi resmi. Kosongkan sampai domain tersedia.
VITE_SITE_URL=
# Tetap false selama data dummy atau data bisnis belum disetujui.
VITE_SITE_INDEXABLE=false
# Vercel mengisi environment ini otomatis dari VERCEL_ENV melalui Vite.
# Untuk pengujian lokal saja: development, preview, atau production.
VITE_DEPLOYMENT_ENV=development
